  linuxWorkerPoolId         String?               @db.Char(32)
  linuxWorkerInstanceId     String?               @db.VarChar(191)
  priority                  Int                   @default(0)
  startAt                   DateTime?
  dueAt                     DateTime?
  acceptanceMode            String                @db.VarChar(16)
  acceptanceReviewerId      String?               @db.VarChar(64)
  archivedAt                DateTime?
  recurrenceRule            String?               @db.VarChar(512)
  accountableUserId         String?               @db.VarChar(64)
  executionMode             String?               @db.VarChar(16)
  preferredAgentProfileId   String?               @db.VarChar(96)
  capabilityRequirements    Json?
  scopePolicy               Json?
  acceptancePolicy          Json?
  budgetPolicy              Json?
  dispatchPolicy            Json?
  currentLoopRunId          String?               @db.VarChar(96)
  version                   Int                   @default(1)
  startedAt                 DateTime?
  completedAt               DateTime?
  publishedAt               DateTime?
  publicationStatus         String                @default("unreleased") @db.VarChar(16)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  team                      Team                  @relation(fields: [teamId], references: [id])
  workflowInstance          WorkflowInstance?     @relation(fields: [workflowInstanceId], references: [id])
  project                   Project?              @relation(fields: [projectId], references: [id])
  stepTemplate              WorkflowStepTemplate? @relation(fields: [stepTemplateId], references: [id])
  space                     Space                 @relation(fields: [spaceId], references: [id])
  createdBy                 User                  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  statusDefinition          TaskStatusDefinition? @relation(fields: [statusDefinitionId], references: [id])
  acceptanceReviewer        User?                 @relation("TaskAcceptanceReviewer", fields: [acceptanceReviewerId], references: [id])
  assignee                  User?                 @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  events                    TaskEvent[]
  toolSessions              ToolSession[]
  milestone                 Milestone?            @relation(fields: [milestoneId], references: [id])
  parentTask                Task?                 @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks                Task[]                @relation("TaskHierarchy")
  predecessorDependencies   TaskDependency[]      @relation("TaskDependencyPredecessor")
  successorDependencies     TaskDependency[]      @relation("TaskDependencySuccessor")
  checkDefinitions          CheckDefinition[]
  agentRuns                 AgentRun[]
  loopRuns                  LoopRun[]
  approvalRequests          ApprovalRequest[]
  artifacts                 Artifact[]
  checkResults              CheckResult[]
  members                   TaskMember[]
  blockers                  TaskBlocker[]
  comments                  TaskComment[]
  activities                TaskActivity[]
  labelAssignments          TaskLabelAssignment[]
  documentLinks             TaskDocumentLink[]
  attachments               TaskAttachment[]
  reminders                 TaskReminder[]
  workflowLinks             TaskWorkflowLink[]
  customFieldValues         TaskFieldValue[]
  workflowInteractions      WorkflowInteraction[]

  @@unique([projectId, taskNumber])
  @@unique([projectId, taskBranch])
  @@index([teamId, status])
  @@index([assigneeUserId, status, queuePosition])
  @@index([workflowInstanceId, createdAt])
  @@index([milestoneId, status, priority])
  @@index([parentTaskId])
  @@index([spaceId, statusCategory, dueAt])
  @@index([spaceId, visibility, updatedAt])
  @@index([createdById, createdAt])
  @@index([linuxWorkerPoolId, linuxWorkerInstanceId])
}

