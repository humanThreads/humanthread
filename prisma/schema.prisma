generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Team {
  id                String             @id @db.VarChar(64)
  name              String             @db.VarChar(191)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  projects          Project[]
  matterTypes       MatterType[]
  workflowTemplates WorkflowTemplate[]
  workflowInstances WorkflowInstance[]
  tasks             Task[]
}

model Company {
  id                 String              @id @db.VarChar(64)
  name               String              @db.VarChar(191)
  slug               String              @unique @db.VarChar(128)
  status             String              @db.VarChar(32)
  description        String?             @db.Text
  logoUrl            String?             @db.VarChar(512)
  certificationLevel String              @default("normal") @db.VarChar(32)
  emailHost          String?             @db.VarChar(191)
  emailPort          Int?
  emailUsername      String?             @db.VarChar(191)
  emailPassword      String?             @db.VarChar(191)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  members            CompanyMember[]
  invitations        CompanyInvitation[]
  projects           Project[]
  space              Space?
  workerPools        WorkerPool[]
  workerModelSites   WorkerModelSite[]
  workerImageSources WorkerImageSource[]
}

model CompanyMember {
  id        String   @id @db.VarChar(96)
  companyId String   @db.VarChar(64)
  userId    String   @db.VarChar(64)
  role      String   @db.VarChar(32)
  status    String   @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([userId, status])
}

model CompanyInvitation {
  id           String    @id @db.VarChar(128)
  companyId    String    @db.VarChar(64)
  email        String    @db.VarChar(191)
  role         String    @db.VarChar(32)
  status       String    @db.VarChar(32)
  invitedById  String    @db.VarChar(64)
  acceptedById String?   @db.VarChar(64)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id])
  invitedBy    User      @relation("CompanyInvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?     @relation("CompanyInvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@unique([companyId, email])
  @@index([email, status, expiresAt])
  @@index([invitedById, createdAt])
  @@index([acceptedById, acceptedAt])
}

model User {
  id                                 String                          @id @db.VarChar(64)
  teamId                             String                          @db.VarChar(64)
  name                               String                          @db.VarChar(191)
  email                              String?                         @unique @db.VarChar(191)
  status                             String                          @db.VarChar(32)
  passwordHash                       String?                         @db.VarChar(191)
  agentApiTokenHash                  String?                         @db.VarChar(191)
  avatarUrl                          String?                         @db.VarChar(512)
  avatarUpdatedAt                    DateTime?
  isSiteAdmin                        Boolean                         @default(false)
  lastSeenAt                         DateTime?
  createdAt                          DateTime                        @default(now())
  updatedAt                          DateTime                        @updatedAt
  team                               Team                            @relation(fields: [teamId], references: [id])
  assignedTasks                      Task[]                          @relation("TaskAssignee")
  createdWorkflows                   WorkflowInstance[]              @relation("WorkflowCreatedBy")
  localDevices                       LocalDevice[]
  desktopSessions                    DesktopSession[]
  webSessions                        WebSession[]
  desktopWebHandoffs                 DesktopWebHandoff[]
  companyMemberships                 CompanyMember[]
  sentCompanyInvitations             CompanyInvitation[]             @relation("CompanyInvitationInvitedBy")
  acceptedCompanyInvitations         CompanyInvitation[]             @relation("CompanyInvitationAcceptedBy")
  projectMemberships                 ProjectMember[]
  personalProjects                   Project[]                       @relation("PersonalProjectOwner")
  createdDocuments                   Document[]                      @relation("DocumentCreatedBy")
  updatedDocuments                   Document[]                      @relation("DocumentUpdatedBy")
  deletedDocuments                   Document[]                      @relation("DocumentDeletedBy")
  documentRevisions                  DocumentRevision[]              @relation("DocumentRevisionCreatedBy")
  createdDocumentDirectories         DocumentDirectory[]             @relation("DocumentDirectoryCreatedBy")
  updatedDocumentDirectories         DocumentDirectory[]             @relation("DocumentDirectoryUpdatedBy")
  uploadedDocumentAttachments        DocumentAttachment[]            @relation("DocumentAttachmentUploadedBy")
  mcpCredentials                     McpCredential[]
  registrationEmailVerifications     RegistrationEmailVerification[]
  notificationReads                  WorkbenchNotificationRead[]
  personalSpace                      Space?                          @relation("PersonalSpaceOwner")
  createdTasks                       Task[]                          @relation("TaskCreatedBy")
  acceptanceReviewTasks              Task[]                          @relation("TaskAcceptanceReviewer")
  taskMemberships                    TaskMember[]
  taskComments                       TaskComment[]
  taskActivities                     TaskActivity[]
  taskSavedViews                     TaskSavedView[]
  createdTaskBlockers                TaskBlocker[]                   @relation("TaskBlockerCreatedBy")
  ownedTaskBlockers                  TaskBlocker[]                   @relation("TaskBlockerOwner")
  resolvedTaskBlockers               TaskBlocker[]                   @relation("TaskBlockerResolvedBy")
  createdTaskLabels                  TaskLabel[]                     @relation("TaskLabelCreatedBy")
  taskLabelAssignments               TaskLabelAssignment[]
  taskDocumentLinks                  TaskDocumentLink[]
  taskAttachments                    TaskAttachment[]
  receivedTaskReminders              TaskReminder[]                  @relation("TaskReminderRecipient")
  createdTaskReminders               TaskReminder[]                  @relation("TaskReminderCreatedBy")
  createdTaskStatusDefinitions       TaskStatusDefinition[]          @relation("TaskStatusDefinitionCreatedBy")
  ownedLoopDefinitions               LoopDefinition[]                @relation("LoopDefinitionOwner")
  publishedLoopVersions              LoopVersion[]                   @relation("LoopVersionPublisher")
  developmentTemplates               ProjectDevelopmentTemplate[]    @relation("DevelopmentTemplateCreatedBy")
  createdProjectLoopBindings         ProjectLoopBinding[]            @relation("ProjectLoopBindingCreator")
  createdAutomationGrants            AutomationGrant[]               @relation("AutomationGrantCreator")
  projectDeviceWorkspaces            ProjectDeviceWorkspace[]
  deviceAgentRuntimeProfiles         DeviceAgentRuntimeProfile[]
  notificationIntents                NotificationIntent[]            @relation("NotificationIntentRecipient")
  reviewedKnowledgeCandidates        KnowledgeCandidate[]            @relation("KnowledgeCandidateReviewer")
  createdProjectTaskFieldDefinitions ProjectTaskFieldDefinition[]    @relation("ProjectTaskFieldDefinitionCreatedBy")
  workflowInteractionMessages        WorkflowInteractionMessage[]    @relation("WorkflowInteractionMessageActor")
  workflowInteractionAttachments     WorkflowInteractionAttachment[] @relation("WorkflowInteractionAttachmentUploader")
  workflowInteractionMentions        WorkflowInteractionMention[]
  workflowInteractionDecisions       WorkflowInteractionDecision[]   @relation("WorkflowInteractionDecisionActor")
  workerPools                        WorkerPool[]                    @relation("WorkerPoolOwner")
  workerPoolAudits                   WorkerPoolAudit[]               @relation("WorkerPoolAuditActor")
  workerModelSites                   WorkerModelSite[]               @relation("WorkerModelSiteOwner")
  createdWorkerImageSources          WorkerImageSource[]             @relation("WorkerImageSourceCreator")

  @@index([teamId, status])
}

model Space {
  id                    String                       @id @db.VarChar(96)
  type                  String                       @db.VarChar(32)
  ownerUserId           String?                      @unique @db.VarChar(64)
  companyId             String?                      @unique @db.VarChar(64)
  name                  String                       @db.VarChar(191)
  status                String                       @default("active") @db.VarChar(32)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  ownerUser             User?                        @relation("PersonalSpaceOwner", fields: [ownerUserId], references: [id])
  company               Company?                     @relation(fields: [companyId], references: [id])
  projects              Project[]
  documents             Document[]
  documentDirectories   DocumentDirectory[]
  agentProfiles         AgentProfile[]
  agentWorkers          AgentWorker[]
  tasks                 Task[]
  taskStatusDefinitions TaskStatusDefinition[]
  taskSavedViews        TaskSavedView[]
  taskLabels            TaskLabel[]
  loopDefinitions       LoopDefinition[]
  developmentTemplates  ProjectDevelopmentTemplate[]
  automationGrants      AutomationGrant[]

  @@index([type, status])
}

model WorkbenchNotificationRead {
  id             String   @id @db.VarChar(128)
  userId         String   @db.VarChar(64)
  notificationId String   @db.VarChar(191)
  readAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, notificationId])
  @@index([userId, readAt])
}

model SiteSetting {
  key       String   @id @db.VarChar(96)
  value     String   @db.VarChar(1024)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationEmailVerification {
  id         String    @id @db.VarChar(96)
  email      String    @db.VarChar(191)
  codeHash   String    @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?   @db.VarChar(64)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([email, consumedAt, expiresAt])
}

model Project {
  id                              String                       @id @db.VarChar(64)
  teamId                          String                       @db.VarChar(64)
  spaceId                         String?                      @db.VarChar(96)
  ownerType                       String                       @default("company") @db.VarChar(32)
  companyId                       String?                      @db.VarChar(64)
  ownerUserId                     String?                      @db.VarChar(64)
  visibility                      String                       @default("private") @db.VarChar(32)
  name                            String                       @db.VarChar(191)
  description                     String?                      @db.Text
  orchestrationStatus             String?                      @db.VarChar(32)
  objective                       String?                      @db.Text
  managerUserId                   String?                      @db.VarChar(64)
  shortCode                       String?                      @db.VarChar(12)
  nextTaskNumber                  Int                          @default(100001)
  startAt                         DateTime?
  targetAt                        DateTime?
  completedAt                     DateTime?
  orchestrationPolicyId           String?                      @db.VarChar(96)
  developmentTemplateKey          String?                      @db.VarChar(96)
  developmentTemplateVersion      Int?
  developmentTemplateConfig       Json?
  /// Project-owned Loop group snapshot; template changes do not mutate this value.
  loopGroupConfig                 Json?
  productionBranch                String?                      @db.VarChar(191)
  stagingBranch                   String?                      @db.VarChar(191)
  releaseAgentProfileId           String?                      @db.VarChar(96)
  workerPoolId                    String?                      @db.Char(32)
  workerRepositoryUrl             String?                      @db.VarChar(1024)
  workerBranchPolicy              Json?
  /// Provider, auth mode and verification metadata for the project Git repository. Values are never persisted here.
  repositoryConfiguration         Json?
  /// Worker image metadata; deployments always use the immutable digest.
  workerImageRepository           String?                      @db.VarChar(1024)
  workerImageTag                  String?                      @db.VarChar(191)
  workerImageDigest               String?                      @db.Char(71)
  workerImageResolvedAt           DateTime?
  /// Immutable Worker image selected from the platform image catalog.
  workerImageVersionId            String?                      @db.Char(32)
  /// Versioned Kubernetes/Docker deployment settings selected by this Project.
  workerDeploymentConfiguration   Json?
  /// Project-wide execution credential metadata; values are never persisted here.
  environmentConfiguration        Json?
  environmentConfigurationVersion Int                          @default(1)
  version                         Int                          @default(1)
  localPath                       String?                      @db.VarChar(512)
  defaultCommand                  String?                      @db.VarChar(191)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  team                            Team                         @relation(fields: [teamId], references: [id])
  space                           Space?                       @relation(fields: [spaceId], references: [id])
  company                         Company?                     @relation(fields: [companyId], references: [id])
  ownerUser                       User?                        @relation("PersonalProjectOwner", fields: [ownerUserId], references: [id])
  developmentTemplate             ProjectDevelopmentTemplate?  @relation(fields: [developmentTemplateKey, developmentTemplateVersion], references: [key, version])
  workerPool                      WorkerPool?                  @relation("ProjectWorkerPool", fields: [workerPoolId], references: [id])
  workerImageVersion              WorkerImageVersion?          @relation("ProjectWorkerImageVersion", fields: [workerImageVersionId], references: [id])
  workerValidationChallenges      WorkerValidationChallenge[]
  members                         ProjectMember[]
  documents                       Document[]
  documentDirectories             DocumentDirectory[]
  workflowInstances               WorkflowInstance[]
  tasks                           Task[]
  stages                          ProjectStage[]
  milestones                      Milestone[]
  taskDependencies                TaskDependency[]
  checkDefinitions                CheckDefinition[]
  workflowDefinitionVersions      WorkflowDefinitionVersion[]
  workspaces                      Workspace[]
  approvalRequests                ApprovalRequest[]
  artifacts                       Artifact[]
  taskStatusDefinitions           TaskStatusDefinition[]
  agentRuns                       AgentRun[]
  loopRuns                        LoopRun[]
  loopBindings                    ProjectLoopBinding[]
  automationGrants                AutomationGrant[]
  notificationIntents             NotificationIntent[]
  knowledgeCandidates             KnowledgeCandidate[]
  deviceWorkspaces                ProjectDeviceWorkspace[]
  taskFieldDefinitions            ProjectTaskFieldDefinition[]
  milestoneReleaseSnapshots       MilestoneReleaseSnapshot[]
  workflowInteractions            WorkflowInteraction[]

  @@unique([teamId, shortCode])
  @@index([teamId, name])
  @@index([spaceId, name])
  @@index([companyId, name])
  @@index([ownerUserId, name])
  @@index([workerPoolId])
}

/// Project-owned HumanThread managed environment secret. Values are encrypted at rest and never exposed by management reads.
model ProjectEnvironmentSecret {
  id               String    @id @db.Char(32)
  projectDigest    String    @db.Char(32)
  name             String    @db.VarChar(191)
  encryptedValue   String    @db.Text
  valueFingerprint String    @db.Char(64)
  status           String    @default("active") @db.VarChar(32)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  revokedAt        DateTime?

  @@unique([projectDigest, name])
  @@index([projectDigest, status])
}

model ProjectDevelopmentTemplate {
  id                       String    @id @db.VarChar(96)
  key                      String    @db.VarChar(96)
  name                     String    @db.VarChar(191)
  version                  Int
  status                   String    @db.VarChar(32)
  spaceId                  String?   @db.VarChar(96)
  origin                   String    @default("platform") @db.VarChar(16)
  kind                     String    @default("branch-development") @db.VarChar(96)
  description              String?   @db.Text
  createdByUserId          String?   @db.VarChar(64)
  sourceTemplateId         String?   @db.VarChar(96)
  revision                 Int       @default(1)
  projectConfigSchema      Json
  taskFieldSchema          Json
  developmentLoopVersionId String?   @db.VarChar(96)
  releaseLoopVersionId     String?   @db.VarChar(96)
  triggerPolicy            Json
  executionPolicy          Json
  loopGroupConfig          Json?
  isPublic                 Boolean   @default(false)
  publicAt                 DateTime?
  deletedAt                DateTime?
  industryTags             Json?
  starCount                Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  space                    Space?    @relation(fields: [spaceId], references: [id])
  createdBy                User?     @relation("DevelopmentTemplateCreatedBy", fields: [createdByUserId], references: [id])
  projects                 Project[]

  @@unique([key, version])
  @@index([key, status])
  @@index([spaceId, status, updatedAt])
  @@index([origin, status, updatedAt])
  @@index([isPublic, deletedAt, publicAt])
  @@index([isPublic, deletedAt, starCount])
}

model DevelopmentTemplateMarketStar {
  id             String   @id @db.Char(32)
  templateDigest String   @db.Char(32)
  userDigest     String   @db.Char(32)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([templateDigest, userDigest])
  @@index([templateDigest, createdAt])
}

model MilestoneReleaseSnapshot {
  id                   String   @id @db.VarChar(96)
  projectId            String   @db.VarChar(64)
  milestoneId          String   @db.VarChar(96)
  loopRunId            String   @unique @db.VarChar(96)
  triggerType          String   @db.VarChar(32)
  snapshot             Json
  checksum             String   @db.VarChar(128)
  stagingBaseCommit    String   @db.VarChar(64)
  productionBaseCommit String   @db.VarChar(64)
  createdAt            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id])
  loopRun              LoopRun  @relation(fields: [loopRunId], references: [id])

  @@index([projectId, milestoneId, createdAt])
}

model ReleasePlan {
  id               String            @id @db.Char(32)
  projectId        String            @db.Char(32)
  name             String            @db.VarChar(191)
  status           String            @db.VarChar(32)
  loopRunId        String?           @unique @db.Char(32)
  selectedSnapshot Json
  failureReason    String?           @db.Text
  retryOfId        String?           @db.Char(32)
  createdById      String            @db.Char(32)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            ReleasePlanTask[]

  @@index([projectId, status, createdAt])
  @@index([retryOfId])
}

model ReleasePlanTask {
  id            String      @id @db.Char(32)
  releasePlanId String      @db.Char(32)
  taskId        String      @db.Char(32)
  milestoneId   String?     @db.Char(32)
  stageId       String?     @db.Char(32)
  taskTitle     String      @db.VarChar(191)
  status        String      @db.VarChar(32)
  createdAt     DateTime    @default(now())
  releasePlan   ReleasePlan @relation(fields: [releasePlanId], references: [id])

  @@unique([releasePlanId, taskId])
  @@index([taskId, status])
}

model ProjectMember {
  id        String   @id @db.VarChar(96)
  projectId String   @db.VarChar(64)
  userId    String   @db.VarChar(64)
  role      String   @db.VarChar(32)
  status    String   @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId, status])
}

model Document {
  id                     String               @id @db.VarChar(96)
  spaceId                String?              @db.VarChar(96)
  projectId              String?              @db.VarChar(64)
  containerKey           String?              @db.VarChar(191)
  directoryId            String?              @db.VarChar(96)
  title                  String               @db.VarChar(191)
  path                   String               @db.VarChar(512)
  contentMarkdown        String               @db.LongText
  format                 String               @default("markdown") @db.VarChar(16)
  version                Int
  sortOrder              Int                  @default(0)
  deletedAt              DateTime?
  deletedById            String?              @db.VarChar(64)
  deletedFromPath        String?              @db.VarChar(512)
  deletedFromDirectoryId String?              @db.VarChar(96)
  createdById            String               @db.VarChar(64)
  updatedById            String               @db.VarChar(64)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  space                  Space?               @relation(fields: [spaceId], references: [id])
  project                Project?             @relation(fields: [projectId], references: [id])
  directory              DocumentDirectory?   @relation(fields: [directoryId], references: [id])
  createdBy              User                 @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedBy              User                 @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy              User?                @relation("DocumentDeletedBy", fields: [deletedById], references: [id])
  revisions              DocumentRevision[]
  attachments            DocumentAttachment[]
  taskLinks              TaskDocumentLink[]

  @@unique([projectId, path])
  @@unique([containerKey, path])
  @@index([spaceId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([directoryId, sortOrder])
  @@index([containerKey, deletedAt, sortOrder])
  @@map("ProjectDocument")
}

model DocumentPermission {
  id              String    @id @db.Char(32)
  spaceDigest     String    @db.Char(32)
  documentDigest  String?   @db.Char(32)
  directoryDigest String?   @db.Char(32)
  userDigest      String    @db.Char(32)
  permission      String    @db.VarChar(16)
  createdByDigest String    @db.Char(32)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?

  @@unique([spaceDigest, documentDigest, directoryDigest, userDigest])
  @@index([spaceDigest, userDigest, revokedAt])
  @@index([documentDigest, userDigest, revokedAt])
  @@index([directoryDigest, userDigest, revokedAt])
}

model DocumentDirectory {
  id           String              @id @db.VarChar(96)
  spaceId      String              @db.VarChar(96)
  projectId    String?             @db.VarChar(64)
  containerKey String              @db.VarChar(191)
  parentId     String?             @db.VarChar(96)
  name         String              @db.VarChar(191)
  path         String              @db.VarChar(512)
  sortOrder    Int                 @default(0)
  createdById  String              @db.VarChar(64)
  updatedById  String              @db.VarChar(64)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  space        Space               @relation(fields: [spaceId], references: [id])
  project      Project?            @relation(fields: [projectId], references: [id])
  parent       DocumentDirectory?  @relation("DocumentDirectoryTree", fields: [parentId], references: [id])
  children     DocumentDirectory[] @relation("DocumentDirectoryTree")
  documents    Document[]
  createdBy    User                @relation("DocumentDirectoryCreatedBy", fields: [createdById], references: [id])
  updatedBy    User                @relation("DocumentDirectoryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([containerKey, path])
  @@index([parentId, sortOrder])
  @@index([spaceId, projectId])
}

model DocumentAttachment {
  id           String    @id @db.VarChar(96)
  documentId   String    @db.VarChar(96)
  storageKey   String    @unique @db.VarChar(512)
  originalName String    @db.VarChar(255)
  mimeType     String    @db.VarChar(191)
  byteSize     BigInt
  uploadedById String    @db.VarChar(64)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  document     Document  @relation(fields: [documentId], references: [id])
  uploadedBy   User      @relation("DocumentAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([documentId, deletedAt, createdAt])
}

model DocumentRevision {
  id              String   @id @db.VarChar(128)
  documentId      String   @db.VarChar(96)
  version         Int
  contentMarkdown String   @db.LongText
  createdById     String   @db.VarChar(64)
  source          String   @db.VarChar(32)
  createdAt       DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id])
  createdBy       User     @relation("DocumentRevisionCreatedBy", fields: [createdById], references: [id])

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model McpCredential {
  id         String    @id @db.VarChar(96)
  userId     String    @db.VarChar(64)
  name       String    @db.VarChar(191)
  tokenHash  String    @db.VarChar(191)
  status     String    @db.VarChar(32)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([tokenHash])
}

model MatterType {
  id                 String             @id @db.VarChar(64)
  teamId             String             @db.VarChar(64)
  name               String             @db.VarChar(191)
  description        String?            @db.Text
  workflowTemplateId String?            @db.VarChar(64)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  team               Team               @relation(fields: [teamId], references: [id])
  workflowTemplate   WorkflowTemplate?  @relation(fields: [workflowTemplateId], references: [id])
  workflowInstances  WorkflowInstance[]

  @@index([teamId, name])
}

model WorkflowTemplate {
  id                String                 @id @db.VarChar(64)
  teamId            String                 @db.VarChar(64)
  name              String                 @db.VarChar(191)
  version           Int
  firstStepKey      String                 @db.VarChar(128)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  team              Team                   @relation(fields: [teamId], references: [id])
  stepTemplates     WorkflowStepTemplate[]
  matterTypes       MatterType[]
  workflowInstances WorkflowInstance[]

  @@index([teamId, isActive])
}

model WorkflowStepTemplate {
  id                 String           @id @db.VarChar(64)
  workflowTemplateId String           @db.VarChar(64)
  key                String           @db.VarChar(128)
  title              String           @db.VarChar(191)
  description        String           @db.Text
  executorType       String           @db.VarChar(16)
  assigneeUserId     String?          @db.VarChar(64)
  nextStepKey        String?          @db.VarChar(128)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  tasks              Task[]

  @@unique([workflowTemplateId, key])
  @@index([workflowTemplateId])
}

model WorkflowInstance {
  id                 String             @id @db.VarChar(64)
  teamId             String             @db.VarChar(64)
  projectId          String             @db.VarChar(64)
  matterTypeId       String             @db.VarChar(64)
  workflowTemplateId String             @db.VarChar(64)
  title              String             @db.VarChar(191)
  description        String?            @db.Text
  status             String             @db.VarChar(32)
  currentStepKey     String             @db.VarChar(128)
  createdById        String             @db.VarChar(64)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  team               Team               @relation(fields: [teamId], references: [id])
