# HumanThread configuration template.
# Copy to .env for local development and fill in real values.
# Never commit real credentials; production values belong in the deployment
# platform's secret store.

# --- Required for the Web service ---
DATABASE_URL="mysql://humanthread:change-me@127.0.0.1:3306/humanthread"

# Public base URL used to build callbacks, download links and MCP snippets.
HUMANTHREAD_SITE_BASE_URL="http://localhost:3000"

# Source repository published in the site footer to satisfy AGPL-3.0 section 13.
HUMANTHREAD_SOURCE_REPOSITORY="https://github.com/humanThreads/humanthread"

# --- Session and encryption secrets (generate your own, 32+ random bytes) ---
HUMANTHREAD_BINDING_CODE_SECRET="change-me"
HUMANTHREAD_WEB_SESSION_SECRET="change-me"
HUMANTHREAD_DESKTOP_SESSION_SECRET="change-me"
HUMANTHREAD_PROJECT_ENVIRONMENT_SECRET_ENCRYPTION_KEY="change-me"
HUMANTHREAD_WORKER_POOL_TOKEN_ENCRYPTION_KEY="change-me"
HUMANTHREAD_WORKER_MODEL_SITE_ENCRYPTION_KEY="change-me"

# Optional password assigned to the initial administrator created by the seed.
HUMANTHREAD_INITIAL_USER_PASSWORD=""

# --- Development toggles ---
HUMANTHREAD_DEVELOPMENT_MODES="true"
# Comma-separated origins allowed to load Next.js development resources.
HUMANTHREAD_DEV_ALLOWED_ORIGINS="localhost"
# Comma-separated origins allowed to call the desktop session endpoints.
HUMANTHREAD_DESKTOP_ALLOWED_ORIGINS="http://localhost:5173"
# Comma-separated Git hosts allowed for project repository verification.
HUMANTHREAD_PRIVATE_GIT_HOST_ALLOWLIST="github.com"

# --- Orchestration worker ---
HUMANTHREAD_ORCHESTRATION_POLL_MS="1000"

# --- Knowledge indexer ---
HUMANTHREAD_KNOWLEDGE_INDEXER_URL="http://127.0.0.1:3100"
HUMANTHREAD_KNOWLEDGE_INDEXER_TOKEN="change-me"
HUMANTHREAD_QDRANT_URL="http://127.0.0.1:6333"
HUMANTHREAD_QDRANT_API_KEY=""
HUMANTHREAD_EMBEDDING_PROFILE_KEY="bge-small-zh-v1.5-int8"
HUMANTHREAD_EMBEDDING_MODEL_ID="BAAI/bge-small-zh-v1.5"
HUMANTHREAD_EMBEDDING_MODEL_REVISION=""
HUMANTHREAD_EMBEDDING_DIMENSIONS="512"
HUMANTHREAD_EMBEDDING_MAX_LENGTH="512"
HUMANTHREAD_EMBEDDING_THREADS="1"
HUMANTHREAD_EMBEDDING_BATCH_SIZE="4"

# --- Optional mail delivery for reminders and notifications ---
HUMANTHREAD_SMTP_HOST=""
HUMANTHREAD_SMTP_PORT="587"
HUMANTHREAD_SMTP_USERNAME=""
HUMANTHREAD_SMTP_PASSWORD=""

# --- Optional Redis cache ---
HUMANTHREAD_REDIS_URL=""

# --- Client download hosting (S3-compatible object storage) ---
HUMANTHREAD_OSS_ENDPOINT="https://s3.example.com"
HUMANTHREAD_OSS_REGION=""
HUMANTHREAD_OSS_BUCKET="humanthread-downloads"
HUMANTHREAD_OSS_ACCESS_KEY_ID=""
HUMANTHREAD_OSS_ACCESS_KEY_SECRET=""
HUMANTHREAD_OSS_DOWNLOAD_TTL_SECONDS="60"
HUMANTHREAD_DOWNLOAD_RATE_LIMIT_MAX="5"
HUMANTHREAD_DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS="60"

# --- Android release signing ---
HUMANTHREAD_ANDROID_KEYSTORE_PATH=""
HUMANTHREAD_ANDROID_KEYSTORE_PASSWORD=""
HUMANTHREAD_ANDROID_KEY_ALIAS=""
HUMANTHREAD_ANDROID_KEY_PASSWORD=""
# Deployment URL loaded by the Capacitor shell.
HUMANTHREAD_MOBILE_SERVER_URL="http://localhost:3000"
